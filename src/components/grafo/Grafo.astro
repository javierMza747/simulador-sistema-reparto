---
// Aquí podrías recibir props si quisieras, por ahora lo dejamos vacío
---

<div class="relative w-full h-screen bg-gray-900 overflow-hidden">
  <!-- Panel de Controles (estilo Tweakpane manual con Tailwind) -->
  <div class="absolute top-5 left-5 z-10 bg-black/70 p-6 rounded-xl border border-gray-700 backdrop-blur-md text-white w-72">
    <h2 class="text-xl font-bold mb-4 text-red-500">Simulador Previsional</h2>
    
    <div class="space-y-4">
      <div>
        <label class="block text-sm opacity-80">Aportantes por Jubilado</label>
        <input type="range" id="ratio-range" min="1" max="5" step="0.5" value="3" class="w-full h-2 bg-gray-700 rounded-lg appearance-none cursor-pointer accent-red-500">
        <div class="flex justify-between text-xs mt-1">
          <span>1</span>
          <span id="ratio-val" class="font-bold text-red-400">3.0</span>
          <span>5</span>
        </div>
      </div>

      <button id="btn-expandir" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-lg transition-colors">
        Avanzar 10 Años
      </button>

      <div class="pt-4 border-t border-gray-700 text-sm space-y-1">
        <p>Factor: <span id="factor-display" class="text-cyan-200 font-mono">1 nodo = 100.000 personas</span></p>
        <p>Nivel: <span id="level-display" class="text-red-400 font-mono">0</span></p>
        <p>Población: <span id="nodes-display" class="text-red-400 font-mono">1</span></p>
        <p>Población estimada: <span id="poblacion-estimada-display" class="text-cyan-200 font-mono">6,000,000</span></p>
        <p>Aportantes: <span id="aportantes-display" class="text-sky-300 font-mono">0</span></p>
        <p>Jubilados: <span id="jubilados-display" class="text-rose-300 font-mono">6,000,000</span></p>
        <p>Relación A/J: <span id="ratio-aj-display" class="text-amber-300 font-mono">0.00</span></p>
        <p>Reserva: <span id="reserva-display" class="text-emerald-300 font-mono">0</span></p>
        <p>Fallecidos (ciclo): <span id="fallecidos-display" class="text-gray-300 font-mono">0</span></p>
      </div>
    </div>
  </div>

  <!-- Contenedor del Grafo -->
  <div id="canvas-container" class="w-full h-full cursor-grab active:cursor-grabbing"></div>
</div>

<script>
  import * as d3 from 'd3';
  import type { Persona } from './Persona';
  import { expandirGeneracion, FACTOR_COMPRESION, JUBILADOS_INICIALES } from './expandir';

  // Configuración inicial
  let width = window.innerWidth;
  let height = window.innerHeight;
  let ratio = 3;
  let currentLevel = 0;
  const cantidadNodosIniciales = Math.max(1, Math.floor(JUBILADOS_INICIALES / FACTOR_COMPRESION));
  let nodes: Persona[] = Array.from({ length: cantidadNodosIniciales }, (_, index) => ({
    id: index,
    edad: 65,
    level: 0,
    color: 'red',
    peso: FACTOR_COMPRESION,
  }));
  let links: d3.SimulationLinkDatum<Persona>[] = [];

  const container = document.getElementById('canvas-container')!;
  const svg = d3.select(container).append('svg')
    .attr('width', width)
    .attr('height', height);

  // Grupo para permitir zoom
  const g = svg.append('g');

  (svg as any).call(d3.zoom().on('zoom', (event) => {
    g.attr('transform', event.transform);
  }));

  // Configuración de la simulación física
  const linkForce = d3.forceLink<Persona, d3.SimulationLinkDatum<Persona>>(links)
    .id(d => d.id)
    .distance(10);

  const simulation = d3.forceSimulation(nodes)
    .force('link', linkForce)
    .force('charge', d3.forceManyBody().strength(-100))
    .force('center', d3.forceCenter(width / 2, height / 2))
    .on('tick', ticked);

  function ticked() {
    const link = g.selectAll('.link').data(links);
    (link as any).enter().append('line').attr('class', 'link stroke-gray-600 opacity-40').merge(link)
      .attr('x1', (d: any) => d.source.x ?? 0)
      .attr('y1', (d: any) => d.source.y ?? 0)
      .attr('x2', (d: any) => d.target.x ?? 0)
      .attr('y2', (d: any) => d.target.y ?? 0);
      
    const node = g.selectAll<SVGCircleElement, Persona>('.node').data(nodes);
    node.enter().append('circle')
      .attr('class', 'node stroke-black')
      .attr('r', 6)
      .attr('fill', d => d.color)
      .merge(node)
      .attr('cx', d => d.x ?? 0)
      .attr('cy', d => d.y ?? 0);
  }

  function formatearEntero(valor: number) {
    return new Intl.NumberFormat('es-AR', { maximumFractionDigits: 0 }).format(valor);
  }

  function actualizarIndicadores(aportantes: number, jubilados: number, reserva: number, fallecidosEnCiclo: number, poblacionTotal: number) {
    const ratioAJ = jubilados > 0 ? aportantes / jubilados : aportantes;
    document.getElementById('poblacion-estimada-display')!.innerText = formatearEntero(poblacionTotal);
    document.getElementById('aportantes-display')!.innerText = formatearEntero(aportantes);
    document.getElementById('jubilados-display')!.innerText = formatearEntero(jubilados);
    document.getElementById('ratio-aj-display')!.innerText = ratioAJ.toFixed(2);
    document.getElementById('reserva-display')!.innerText = reserva.toString();
    document.getElementById('fallecidos-display')!.innerText = formatearEntero(fallecidosEnCiclo);
  }

  // Lógica de expansión
  function expandir() {
    const resultado = expandirGeneracion(nodes, links, currentLevel, ratio);
    nodes = resultado.nodes;
    links = resultado.links;
    currentLevel = resultado.currentLevel;

    // Actualizar UI y simulación
    document.getElementById('level-display')!.innerText = currentLevel.toString();
    document.getElementById('nodes-display')!.innerText = nodes.length.toString();
    actualizarIndicadores(resultado.aportantes, resultado.jubilados, resultado.reserva, resultado.fallecidosEnCiclo, resultado.poblacionTotal);
    
    simulation.nodes(nodes);
    linkForce.links(links);
    simulation.alpha(1).restart();
  }

  // Event Listeners
  document.getElementById('btn-expandir')!.addEventListener('click', expandir);
  document.getElementById('ratio-range')!.addEventListener('input', (e) => {
    ratio = parseFloat((e.target as HTMLInputElement).value);
    document.getElementById('ratio-val')!.innerText = ratio.toFixed(1);
  });

  // Estado inicial de indicadores.
  const poblacionInicial = nodes.reduce((acc, n) => acc + n.peso, 0);
  document.getElementById('factor-display')!.innerText = `1 nodo = ${formatearEntero(FACTOR_COMPRESION)} personas`;
  document.getElementById('nodes-display')!.innerText = nodes.length.toString();
  actualizarIndicadores(0, poblacionInicial, 0, 0, poblacionInicial);
</script>